<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/speech_dialog_bg"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="绸缪精灵正在听"
        android:textColor="#1C2A26"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/speech_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="点击「开始录制」，说完后点「说完了」"
        android:textColor="#6E7F79"
        android:textSize="13sp" />

    <com.shiguang.reminder.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/speech_btn_cancel"
            android:text="取消"
            android:textColor="#6E7F79"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_record"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:layout_marginStart="8dp"
            android:background="@drawable/speech_btn_record"
            android:text="开始录制"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
