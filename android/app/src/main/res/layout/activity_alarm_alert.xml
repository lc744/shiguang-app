<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10241E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/alarmEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰"
        android:textSize="72sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拾光提醒"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="26sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="到点提醒"
        android:textColor="#DCE8E2"
        android:textSize="17sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="将持续提醒 1 分钟"
        android:textColor="#86B6A7"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/snoozeBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="稍后 10 分钟"
            android:textAllCaps="false"
            android:backgroundTint="#2F7F69"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/doneBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="完成"
            android:textAllCaps="false"
            android:backgroundTint="#FFFFFF"
            android:textColor="#10241E" />
    </LinearLayout>

</LinearLayout>
