/* 首页补充样式：全局 app.wxss 里部分排版依赖 HTML 标签选择器（strong/small/p 等），
   WXML 不使用这些标签，这里以类名等价补充 */
.brand-name{font-size:22px;line-height:1;letter-spacing:.02em;font-weight:700}
.brand-sub{font-size:12px;color:var(--sub)}

/* 统计卡（原 .stats 容器无全局规则，补两列网格） */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 18px 14px}
.stat-num{display:block;font-size:22px;line-height:1;font-weight:800}
.stat-label{display:block;font-size:12px;color:var(--sub);margin-top:4px}

.subhead-title{font-size:15px;font-weight:600}
.subhead-sub{color:var(--sub);font-size:12px}

/* hero 幻灯片 */
.hero-swiper{height:120px}
.hero-cat{display:block;font-size:12px;margin:0 0 6px;opacity:.75;letter-spacing:.05em;font-weight:600;color:#2c5f4d}
.hero-main{display:block;font-size:19px;line-height:1.35;margin:0 0 6px;color:#2c5f4d;font-weight:700;word-wrap:break-word}
.hero-desc{display:block;font-size:13px;line-height:1.6;opacity:.9;color:#3a6b56}

/* 事件卡片内文本 */
.et-time{display:block;font-size:17px;line-height:1}
.et-period{display:block;font-size:10px;color:var(--sub);margin-top:4px;white-space:nowrap}
.eb-name{display:block;font-size:15px;line-height:1.3;margin:0 0 4px;font-weight:700}
.event.done .eb-name{text-decoration:line-through}
.eb-note{display:block;font-size:12px;color:var(--sub);line-height:1.55;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag-img{width:20px;height:20px}

/* 错过横幅内文本 */
.missed-title{font-size:13px;color:#9a6a00;font-weight:700}
.theme-dark .missed-title,.theme-dark .mi-time{color:#e3b95c}

/* 自定义 tabBar 留白 */
.shell{padding-bottom:260rpx}
/* ===== 对齐 App 首页样式 ===== */
/* hero 切换按钮（slide-nav-btn） */
.slide-nav-btn{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.75);color:var(--main);font-size:20px;line-height:34px;text-align:center;z-index:2;box-shadow:0 2px 8px rgba(18,48,39,.12)}
.slide-prev{left:10px}
.slide-next{right:10px}
/* header 文字按钮（日历） */
.txt-btn{width:auto;padding:0 14px;font-size:14px;border-radius:999px}
/* 已完成徽章 */
.done-pill{flex:none;align-self:center;font-size:11px;color:#fff;background:var(--main);border-radius:999px;padding:4px 10px;font-weight:600}
/* 已到点 tag */
.tag-overdue{background:rgba(198,92,82,.12)}
.tag-overdue text{color:#c65c52 !important}
/* 错过横幅条目：单行内联（time + name + emoji） */
.missed-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--bg)}
.mi-time{font-size:13px;color:var(--sub);flex:none}
.mi-name{flex:1;font-size:14px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mi-emoji{font-size:16px}
.mi-emoji-img{width:18px;height:18px}
.missed-close{width:26px;height:26px;border-radius:50%;background:var(--bg);color:var(--sub);display:flex;align-items:center;justify-content:center;font-size:13px;padding:0}