/* 分享页 */
.shell{min-height:100vh;background:var(--bg);padding-bottom:110px}
.subhead{padding:14px 18px 4px}
.subhead-title{font-size:21px;font-weight:800;color:var(--text)}
.subhead-sub{display:block;font-size:12px;color:var(--sub);margin-top:3px}

.seg-row{display:flex;margin:12px 18px 4px;background:var(--card);border-radius:999px;padding:4px}
.seg{flex:1;text-align:center;padding:8px 0;font-size:13px;color:var(--sub);border-radius:999px}
.seg-on{background:var(--accent);color:#fff;font-weight:600}

.share-empty{display:flex;flex-direction:column;align-items:center;padding:70px 40px}
.share-empty-emoji{font-size:44px}
.share-empty-text{margin-top:12px;font-size:14px;color:var(--sub)}
.share-cta{margin-top:20px;padding:10px 26px;font-size:14px}

.post-list{padding:10px 18px 0}
.post-card{margin-bottom:14px;overflow:hidden}
.post-photos{display:flex;gap:6px}
.post-photos .post-photo{flex:1;height:150px;border-radius:10px;background:var(--bg)}
.post-photos .post-photo.single{height:210px;flex:none;width:100%}
.post-body{padding:12px 14px 10px}
.post-head{display:flex;align-items:center;gap:8px}
.post-type{flex:none;font-size:11px;color:var(--accent);background:rgba(36,99,83,.1);border-radius:6px;padding:2px 7px}
.post-name{font-size:15px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.post-desc{display:block;font-size:13px;color:var(--sub);margin-top:6px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.post-meta{display:flex;align-items:center;gap:8px;margin-top:10px}
.post-avatar{width:22px;height:22px;border-radius:50%;flex:none}
.post-avatar-ph{display:flex;align-items:center;justify-content:center;font-size:12px;background:var(--bg)}
.post-author{font-size:12px;color:var(--sub);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.post-tools{margin-left:auto;display:flex;gap:14px}
.post-tool{font-size:12px;color:var(--sub)}
.post-tool.danger{color:#c65c52}

.share-loading{text-align:center;font-size:12px;color:var(--sub);padding:14px 0}

.share-fab{position:fixed;right:22px;bottom:calc(34px + env(safe-area-inset-bottom));width:54px;height:54px;border-radius:50%;background:var(--accent);color:#fff;font-size:26px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(36,99,83,.35)}

/* 攻略入口 */
.plan-entry{display:flex;align-items:center;gap:16rpx;margin:14px 18px 0;padding:22rpx 24rpx}
.plan-entry-emoji{font-size:40rpx}
.plan-entry-text{flex:1;display:flex;flex-direction:column}
.plan-entry-title{font-size:28rpx;font-weight:700;color:var(--text)}
.plan-entry-sub{font-size:22rpx;color:var(--sub);margin-top:4rpx}

/* 攻略弹层 */
.plan-mask{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:999;display:flex;align-items:center;justify-content:center}
.plan-form,.plan-result{width:640rpx;max-height:80vh;overflow-y:auto;padding:36rpx 32rpx 28rpx}
.plan-form-title{font-size:32rpx;font-weight:800;color:var(--text);text-align:center}
.pf-row{display:flex;align-items:center;margin-top:26rpx}
.pf-label{width:150rpx;font-size:27rpx;color:var(--sub);flex:none}
.pf-value{flex:1;background:var(--bg);border-radius:12rpx;padding:14rpx 22rpx;font-size:27rpx;color:var(--text)}
.pp-btns{display:flex;gap:20rpx;margin-top:36rpx}
.pf-cancel{background:var(--bg);color:var(--sub)}
.pf-ok{background:var(--accent);color:#fff;font-weight:600}
.plan-sub{text-align:center;font-size:22rpx;color:var(--sub);margin-top:10rpx}
.plan-list{margin-top:20rpx}
.plan-item{display:flex;align-items:flex-start;gap:18rpx;padding:16rpx 8rpx;border-bottom:1rpx solid var(--line)}
.pi-emoji{font-size:36rpx;flex:none}
.pi-main{flex:1}
.pi-head{display:flex;gap:14rpx;align-items:baseline}
.pi-slot{font-size:27rpx;font-weight:700;color:var(--text)}
.pi-time{font-size:22rpx;color:var(--sub)}
.pi-name{display:block;font-size:25rpx;color:var(--text);margin-top:4rpx}
.pi-addr{display:block;font-size:22rpx;color:var(--sub);margin-top:2rpx}
.plan-close{text-align:center;font-size:24rpx;color:var(--sub);padding:20rpx 0 0}
.pp-btn{flex:1;font-size:28rpx;border-radius:999rpx;line-height:2.4;padding:0;margin:0}
.pp-btn::after{border:none}
/* 筛选行 */
.filter-row{display:flex;align-items:center;gap:12rpx;margin:12px 18px 0;flex-wrap:wrap}
.f-chip{font-size:24rpx;color:var(--sub);background:var(--card);border-radius:999rpx;padding:8rpx 22rpx}
.f-chip.f-on{background:var(--accent);color:#fff;font-weight:600}
.f-city{margin-left:auto}
/* seg 行右侧操作 pill（对齐 App pub-pill） */
.pub-pill{flex:none;font-size:23rpx;color:var(--accent);background:rgba(36,99,83,.1);border-radius:999rpx;padding:8rpx 18rpx;font-weight:600;margin-left:8rpx}
/* 国家名胜入口（对齐 App scenic-entry） */
.scenic-entry{display:flex;align-items:center;gap:16rpx;margin:12px 18px 0;padding:20rpx 24rpx;background:linear-gradient(120deg,rgba(36,99,83,.12),rgba(142,216,248,.14));border:1rpx solid rgba(36,99,83,.18);border-radius:20rpx}
.scenic-entry-emoji{font-size:44rpx}
.scenic-entry-text{flex:1;display:flex;flex-direction:column}
.scenic-entry-title{font-size:28rpx;font-weight:700;color:var(--text)}
.scenic-entry-sub{font-size:22rpx;color:var(--sub);margin-top:4rpx}
.scenic-entry-arrow{font-size:34rpx;color:var(--sub)}

/* 名胜库全屏弹层（对齐 App scenicOverlay） */
.scenic-mask{position:fixed;inset:0;background:rgba(18,48,39,.55);z-index:120;display:flex;align-items:flex-end}
.scenic-lib{width:100%;max-height:86vh;background:var(--surface);border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column;padding:24rpx 24rpx 0;box-sizing:border-box}
.scenic-lib-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.scenic-lib-title{font-size:32rpx;font-weight:800;color:var(--text)}
.scenic-lib-close{font-size:26rpx;color:var(--accent);background:rgba(36,99,83,.1);border-radius:999rpx;padding:8rpx 24rpx}
.scenic-lib-filter{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:14rpx}
.scenic-prov-picker{font-size:24rpx;color:var(--text);background:var(--bg);border:1rpx solid var(--line);border-radius:12rpx;padding:10rpx 20rpx}
.scenic-grades{display:flex;gap:10rpx}
.scenic-search{background:var(--bg);border:1rpx solid var(--line);border-radius:14rpx;padding:14rpx 20rpx;font-size:26rpx;color:var(--text);margin-bottom:12rpx}
.scenic-lib-sub{font-size:22rpx;color:var(--sub);margin-bottom:12rpx}
.scenic-lib-list{flex:1;min-height:0}
.scenic-empty{text-align:center;font-size:26rpx;color:var(--sub);padding:60rpx 0}
.scenic-item{display:flex;gap:16rpx;padding:20rpx 24rpx;margin-bottom:14rpx}
.scenic-emoji{font-size:44rpx;flex:none}
.scenic-main{flex:1;min-width:0}
.scenic-name-row{display:flex;align-items:center;gap:10rpx}
.scenic-name{font-size:28rpx;font-weight:700;color:var(--text)}
.scenic-lv{font-size:18rpx;font-weight:800;color:#fff;background:#246353;border-radius:8rpx;padding:2rpx 10rpx}
.lv5{background:#c98a2b}
.scenic-loc{display:block;font-size:22rpx;color:var(--accent);margin-top:4rpx}
.scenic-desc{display:block;font-size:23rpx;color:var(--sub);line-height:1.5;margin-top:4rpx}
.scenic-ops{display:flex;flex-direction:column;gap:10rpx;justify-content:center;flex:none}
.scenic-op{font-size:21rpx;color:var(--accent);background:rgba(36,99,83,.1);border-radius:999rpx;padding:8rpx 16rpx;white-space:nowrap}
.scenic-list-pad{height:30rpx}