<view class="shell {{themeClass}}">
  <view class="subhead">
    <text class="subhead-title">发布推荐</text>
    <text class="subhead-sub">你的推荐会展示给所有使用绸缪的朋友</text>
  </view>

  <!-- 发布身份：来自「我的」账号资料 -->
  <view class="card p-block">
    <view class="p-label">发布身份</view>
    <view class="id-row" bindtap="goMe">
      <image wx:if="{{avatarUrl}}" class="id-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="id-avatar id-avatar-ph">👤</view>
      <view class="id-info">
        <text class="id-nick">{{hasProfile ? nickname : '未设置身份'}}</text>
        <text class="id-sub">{{hasProfile ? '以这个身份发布 · 点这里可修改' : '点击去「我的」登录并完善资料'}}</text>
      </view>
      <text class="id-arrow">›</text>
    </view>
  </view>

  <!-- 照片 -->
  <view class="card p-block">
    <view class="p-label">照片<text class="p-optional">（选填，最多 3 张；不传则按类型配官方美图）</text></view>
    <view class="photo-grid">
      <view class="photo-cell" wx:for="{{photos}}" wx:key="*this">
        <image class="photo-img" src="{{item}}" mode="aspectFill" data-i="{{index}}" bindtap="previewPhoto" />
        <view class="photo-del" data-i="{{index}}" catchtap="removePhoto">✕</view>
      </view>
      <view wx:if="{{photos.length < 3}}" class="photo-add" bindtap="pickPhotos">＋<text>添加</text></view>
    </view>
  </view>

  <!-- 内容 -->
  <view class="card p-block">
    <view class="p-label">类型</view>
    <view class="type-row">
      <view wx:for="{{types}}" wx:key="*this" class="type-chip {{type === item ? 'on' : ''}}" data-t="{{item}}" bindtap="setType">{{item}}</view>
    </view>
    <view class="p-label mt">名称<text class="p-optional">（选填）</text></view>
    <input class="p-input" placeholder="比如：巷口的抄手店" placeholder-class="ph" value="{{name}}" bindinput="onName" maxlength="30" />
    <view class="p-label mt">所在城市<text class="p-optional">（用于攻略聚合推荐）</text></view>
    <picker mode="region" bindchange="onRegion" value="{{region}}">
      <view class="p-input picker-sim">{{city || '选择省 / 市（选到市级即可）'}}</view>
    </picker>
    <view class="p-label mt">具体位置<text class="p-optional">（选填）</text></view>
    <input class="p-input" placeholder="比如：南禅寺步行街东侧" placeholder-class="ph" value="{{addr}}" bindinput="onAddr" maxlength="60" />
    <view class="p-label mt">推荐理由<text class="p-optional">（选填）</text></view>
    <textarea class="p-textarea" placeholder="说说好在哪：味道、位置、性价比……" placeholder-class="ph" value="{{desc}}" bindinput="onDesc" maxlength="500" />
  </view>

  <button class="primary publish-btn {{uploading ? 'disabled' : ''}}" bindtap="doPublish">{{uploading ? '发布中…' : '发布'}}</button>
  <view class="publish-tip">请文明发布：分享真实体验，尊重他人</view>
</view>
<canvas type="2d" id="defcanvas" style="position:fixed;left:-9999px;top:-9999px;width:480px;height:360px"></canvas>
<privacy-popup />
