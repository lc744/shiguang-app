<view class="shell {{themeClass}}" style="padding-bottom:160rpx">
  <!-- 未登录：整页登录引导（对齐安卓：分享页需登录） -->
  <view wx:if="{{needLogin}}" class="share-login-gate">
    <view class="slg-icon">🔐</view>
    <view class="slg-title">需要登录</view>
    <view class="slg-sub">登录后即可浏览与发布分享</view>
    <button class="primary slg-btn" bindtap="goLogin">微信一键登录</button>
  </view>

  <block wx:else>
  <view class="subhead">
    <text class="subhead-title">分享</text>
    <text class="subhead-sub">把好店与好风景推荐给同好</text>
  </view>

  <view class="seg-row">
    <view class="seg {{tab === 'feed' ? 'seg-on' : ''}}" data-tab="feed" bindtap="switchTab">大众推荐</view>
    <view class="seg {{tab === 'mine' ? 'seg-on' : ''}}" data-tab="mine" bindtap="switchTab">我的发布</view>
    <view class="pub-pill" bindtap="openPlanMaker">🧳 攻略</view>
    <view class="pub-pill" bindtap="goPublish">＋ 发布</view>
  </view>

  <!-- 筛选行（类型 × 城市） -->
  <view class="filter-row" wx:if="{{tab === 'feed'}}">
    <view class="f-chip {{feedType === '' ? 'f-on' : ''}}" data-t="" bindtap="pickFeedType">全部</view>
    <view class="f-chip {{feedType === item ? 'f-on' : ''}}" wx:for="{{feedTypes}}" wx:key="*this" data-t="{{item}}" bindtap="pickFeedType">{{item}}</view>
    <view class="loc-chip" bindtap="locateCity">📍 定位</view>
    <picker mode="region" bindchange="onFeedRegion">
      <view class="f-chip f-city">{{feedCity || '📍 全部城市'}}</view>
    </picker>
  </view>

  <!-- 国家名胜入口（对齐 App scenic-entry） -->
  <view class="scenic-entry" wx:if="{{tab === 'feed'}}" bindtap="openScenic">
    <text class="scenic-entry-emoji">🏛️</text>
    <view class="scenic-entry-text">
      <text class="scenic-entry-title">国家名胜</text>
      <text class="scenic-entry-sub">5A/4A 精选 · 一键成攻略</text>
    </view>
    <text class="scenic-entry-arrow">›</text>
  </view>

  <view wx:if="{{empty}}" class="share-empty">
    <text class="share-empty-emoji">{{tab === 'feed' ? '🌱' : '📭'}}</text>
    <text class="share-empty-text">{{tab === 'feed' ? '还没有人分享，来当第一个' : '你还没有发布过'}}</text>
    <button class="primary share-cta" bindtap="goPublish">＋ 发布推荐</button>
  </view>

  <view class="post-list">
    <view class="post-card card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="goPost">
      <view class="post-photos" wx:if="{{item.photoUrls.length}}">
        <image
          wx:for="{{item.photoUrls}}"
          wx:for-item="ph"
          wx:for-index="pi"
          wx:key="*this"
          class="post-photo {{item.photoUrls.length === 1 ? 'single' : ''}}"
          src="{{ph}}"
          mode="aspectFill"
          lazy-load
          data-urls="{{item.photoUrls}}"
          data-current="{{ph}}"
          catchtap="onImageTap"
        />
      </view>
      <view class="post-body">
        <view class="post-head">
          <text class="post-type">{{item.type}}</text>
          <text class="post-name">{{item.name}}</text>
        </view>
        <text class="post-desc">{{item.desc}}</text>
        <view class="post-meta">
          <image wx:if="{{item.avatarUrl}}" class="post-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="post-avatar post-avatar-ph">👤</view>
          <text class="post-author">{{item.nickname}}</text>
          <view class="post-tools">
            <text class="post-tool">{{item.selfLiked ? '❤️' : '🤍'}} {{item.likes}}</text>
            <text class="post-tool">💬 {{item.commentCount || 0}}</text>
            <text wx:if="{{tab === 'feed'}}" class="post-tool" catchtap="onReport">举报</text>
            <text wx:if="{{tab === 'mine'}}" class="post-tool danger" data-id="{{item._id}}" catchtap="onDel">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="share-loading" wx:if="{{loading}}">加载中…</view>
  <view class="share-loading" wx:if="{{!hasMore && list.length > 3}}">— 到底啦 —</view>

  <!-- 悬浮发布按钮 -->

  <!-- 攻略弹层：选城市/日期 -->
  <view class="plan-mask" wx:if="{{planForm}}" catchtouchmove="noop">
    <view class="plan-form card">
      <view class="plan-form-title">生成行程攻略</view>
      <view class="pf-row">
        <text class="pf-label">城市</text>
        <picker mode="region" bindchange="onPlanRegion" value="{{planRegion}}">
          <view class="pf-value">{{planCity || '选择城市'}}</view>
        </picker>
      </view>
      <view class="pf-row">
        <text class="pf-label">出行日期</text>
        <picker mode="date" start="{{today}}" value="{{planDate}}" bindchange="onPlanDate">
          <view class="pf-value">{{planDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="pp-btns">
        <button class="pp-btn pf-cancel" bindtap="closePlanForm">取消</button>
        <button class="pp-btn pf-ok" bindtap="makePlan">生成</button>
      </view>
    </view>
  </view>

  <!-- 攻略结果弹层 -->
  <view class="plan-mask" wx:if="{{plan}}">
    <view class="plan-result card">
      <view class="plan-form-title">{{plan.city}} · {{plan.dateLabel}}</view>
      <view class="plan-sub">由大家的 {{plan.count}} 条推荐编排 · 加入提醒后到点自动弹出</view>
      <image wx:if="{{planImg}}" class="plan-img" src="{{planImg}}" mode="widthFix" bindtap="previewPlanImg" />
      <view class="plan-list">
        <view class="plan-item" wx:for="{{plan.items}}" wx:key="slot">
          <text class="pi-emoji">{{item.emoji}}</text>
          <view class="pi-main">
            <view class="pi-head">
              <text class="pi-slot">{{item.slot}}</text>
              <text class="pi-time">{{item.time}}</text>
            </view>
            <text class="pi-name">{{item.name}}</text>
            <text wx:if="{{item.addr}}" class="pi-addr">{{item.addr}}</text>
          </view>
        </view>
      </view>
      <view class="pp-btns">
        <button class="pp-btn pf-cancel" bindtap="regenPlan">换一换</button>
        <button class="pp-btn pf-ok" bindtap="addPlanToEvents">加入提醒</button>
      </view>
      <view class="pp-btns" style="margin-top:14rpx">
        <button class="pp-btn pf-cancel" bindtap="savePlan">💾 存入攻略</button>
        <button class="pp-btn pf-cancel" bindtap="makePlanPoster">🖼 保存海报</button>
      </view>
      <view class="plan-close" bindtap="closePlan">收起</view>
    </view>
  </view>
  </block>
</view>
<canvas type="2d" id="plancanvas" style="position:fixed;left:-9999px;top:-9999px;width:300px;height:430px"></canvas>

<!-- 国家名胜库全屏弹层 -->
<view class="scenic-mask" wx:if="{{scenicOpen}}" catchtouchmove="noop">
  <view class="scenic-lib card">
    <view class="scenic-lib-head">
      <text class="scenic-lib-title">🏛️ 国家名胜</text>
      <view class="scenic-lib-close" bindtap="closeScenic">关闭</view>
    </view>
    <view class="scenic-lib-filter">
      <picker range="{{scenicProvs}}" value="{{scenicProvIdx}}" bindchange="onScenicProv">
        <view class="scenic-prov-picker">{{scenicProv || '全部省份'}} ▾</view>
      </picker>
      <view class="scenic-grades">
        <view class="f-chip {{scenicGrade === '' ? 'f-on' : ''}}" data-g="" bindtap="pickScenicGrade">全部</view>
        <view class="f-chip {{scenicGrade === '5' ? 'f-on' : ''}}" data-g="5" bindtap="pickScenicGrade">5A</view>
        <view class="f-chip {{scenicGrade === '4' ? 'f-on' : ''}}" data-g="4" bindtap="pickScenicGrade">4A</view>
      </view>
    </view>
    <input class="scenic-search" placeholder="搜索景点名 / 城市 / 亮点" placeholder-class="ph" value="{{scenicKw}}" bindinput="onScenicKw" />
    <view class="scenic-lib-sub">{{scenicCount}} 个景点 · 点一下按所在城市做攻略</view>
    <scroll-view class="scenic-lib-list" scroll-y>
      <view wx:if="{{!scenicList.length}}" class="scenic-empty">没有匹配的景点，换个条件试试</view>
      <view class="scenic-item card" wx:for="{{scenicList}}" wx:key="n" bindtap="onScenicPlan" data-city="{{item.c}}">
        <text class="scenic-emoji">{{item.e}}</text>
        <view class="scenic-main">
          <view class="scenic-name-row">
            <text class="scenic-name">{{item.n}}</text>
            <text class="scenic-lv lv5">{{item.lv}}</text>
          </view>
          <text class="scenic-loc">{{item.p}} · {{item.c}}</text>
          <text class="scenic-desc">{{item.d}}</text>
        </view>
        <view class="scenic-ops">
          <text class="scenic-op" catchtap="onScenicPlan" data-city="{{item.c}}">🧳 做攻略</text>
          <text class="scenic-op" catchtap="onScenicFilter" data-city="{{item.c}}">📍 筛推荐</text>
        </view>
      </view>
      <view class="scenic-list-pad"></view>
    </scroll-view>
  </view>
</view>
<genie id="geniecomp" showfab="{{false}}" />
