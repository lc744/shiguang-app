/* 内容管理 */
.shell{min-height:100vh;background:var(--bg);padding-bottom:40rpx}
.subhead{padding:14px 18px 4px}
.subhead-title{font-size:21px;font-weight:800;color:var(--text)}
.subhead-sub{display:block;font-size:12px;color:var(--sub);margin-top:3px}
.seg-row{display:flex;margin:12px 18px 4px;background:var(--card);border-radius:999px;padding:4px}
.seg{flex:1;text-align:center;padding:8px 0;font-size:13px;color:var(--sub);border-radius:999px}
.seg-on{background:var(--accent);color:#fff;font-weight:600}
.ad-empty{text-align:center;font-size:26rpx;color:var(--sub);padding:80rpx 0}
.ad-list{padding:14px 18px 0}
.ad-item{display:flex;gap:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx}
.ad-thumb{width:120rpx;height:120rpx;border-radius:12rpx;flex:none;background:var(--bg)}
.ad-main{flex:1;min-width:0}
.ad-name{display:block;font-size:27rpx;font-weight:600;color:var(--text);line-height:1.4;word-break:break-all}
.ad-sub{display:block;font-size:22rpx;color:var(--sub);margin-top:6rpx}
.ad-ops{display:flex;gap:26rpx;margin-top:12rpx}
.ad-op{font-size:24rpx;font-weight:600}
.ad-op.ok{color:var(--accent)}
.ad-op.danger{color:#c65c52}
