<view class="shell">
  <view class="subhead">
    <text class="subhead-title">💬 我的评论</text>
    <text class="subhead-sub">最多显示最近 50 条</text>
  </view>

  <view wx:if="{{loading}}" class="mc-empty">加载中…</view>
  <view wx:elif="{{!list.length}}" class="mc-empty">还没有评论，去帖子下面聊聊吧</view>
  <view wx:else class="mc-list">
    <view class="mc-item card {{item.gone ? 'mc-gone' : ''}}" wx:for="{{list}}" wx:key="cid" bindtap="goPost" data-pid="{{item.postId}}" data-gone="{{item.gone}}">
      <view class="mc-post">
        <text>{{item.emoji}}</text>
        <text class="mc-post-name">{{item.postName}}</text>
        <text wx:if="{{item.gone}}" class="mc-gone-tag">（帖子已删除）</text>
        <text wx:else class="me-arrow">›</text>
      </view>
      <view class="mc-content">{{item.content}}</view>
      <view class="mc-foot">
        <text class="mc-time">{{item.timeText}}</text>
        <text class="mc-del" data-cid="{{item.cid}}" catchtap="onDel">删除</text>
      </view>
    </view>
  </view>
</view>
