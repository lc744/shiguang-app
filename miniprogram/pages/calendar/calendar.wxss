/* 日历页补充样式：全局 app.wxss 里部分排版依赖 HTML 标签选择器（strong/small/span 等），
   WXML 不使用这些标签，这里以类名等价补充 */
.subhead-title{font-size:15px;font-weight:600}
.subhead-sub{color:var(--sub);font-size:12px}

/* 月历标题（点击打开年月选择弹层） */
.month-title{display:flex;align-items:baseline;gap:4px}
.mt-text{font-size:16px;font-weight:700}
.mt-caret{font-size:11px;color:var(--sub)}
.mn-btn{width:30px !important;min-width:0 !important;height:30px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--main);font-size:15px;line-height:1}

/* 星期表头与日期格子 */
.wd{display:block;font-size:11px;color:var(--sub);text-align:center}
.day-num{font-size:13px;font-weight:600;line-height:1}
.day-sub{font-size:10px;color:var(--sub);line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.day.has-festival .day-sub{color:#d4574e;font-weight:600}
.day.has-festival.selected .day-sub{color:#fff}
.day.legal-rest .day-num{color:#2c8a5f}
.day.legal-rest.selected .day-num{color:#fff}
.day.selected .day-num,.day.selected .day-sub{color:#fff}
.theme-dark .day.selected .day-num,.theme-dark .day.selected .day-sub{color:#0c1512}

/* 当日议程 */
.agenda-subhead{padding-left:0;padding-right:0}
.agenda-info{flex:1;min-width:0}
.agenda-name{display:block;font-size:14px}
.agenda-sub{display:block;font-size:12px;color:var(--sub)}
.agenda-arrow{font-size:14px;color:var(--sub)}

/* 年月选择弹层 */
.yp-title{display:block;font-size:17px;margin:0 0 14px;text-align:center;font-weight:700}
.yp-year{font-size:20px;font-weight:700}
.yp-unit{font-size:10px;font-weight:400;color:var(--sub);margin-left:1px}
.yp-month.yp-selected .yp-unit{color:#0c1512}
