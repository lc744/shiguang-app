<view class="shell {{themeClass}}" style="background:{{bgColor}};min-height:100vh;padding-bottom:200rpx">
  <!-- 品牌头（对齐安卓全局 header：每页顶部都有） -->
  <view class="header">
    <view class="brand">
      <text class="brand-name">绸缪</text>
      <text class="brand-sub">记事 · 闹钟 · 语音包 · 表情包</text>
    </view>
    <view class="header-actions">
      <button class="icon-btn txt-btn" bindtap="goHome">今天</button>
    </view>
  </view>

  <!-- 公共区（对齐安卓：hero 幻灯 + 统计卡为首页/预告公共区） -->
  <view class="hero">
    <swiper class="hero-swiper" current="{{slideIndex}}" autoplay="{{true}}" circular="{{true}}" interval="5000" bindchange="onSlideChange">
      <swiper-item wx:for="{{slides}}" wx:key="idx">
        <view class="hero-text">
          <text class="hero-cat">{{item.heroCat}}</text>
          <text class="hero-main">{{item.heroMainTitle}}</text>
          <text class="hero-desc">{{item.heroDesc}}</text>
        </view>
        <view class="hero-decoration">
          <text class="decoration-item">{{item.deco}}</text>
        </view>
      </swiper-item>
    </swiper>
    <view class="slide-nav-btn slide-prev" bindtap="prevSlide">‹</view>
    <view class="slide-nav-btn slide-next" bindtap="nextSlide">›</view>
  </view>

  <view class="stats">
    <view class="card stat"><text class="stat-num">{{statTodo}}</text><text class="stat-label">今日待办</text></view>
    <view class="card stat"><text class="stat-num">{{statDone}}</text><text class="stat-label">已完成</text></view>
    <view class="card stat stat-clear" bindtap="onClearAll"><text class="stat-num">🗑</text><text class="stat-label">清空事件</text></view>
  </view>

  <view class="subhead">
    <text class="subhead-title">预告</text>
    <text class="subhead-sub">接下来会发生什么</text>
  </view>

  <view class="today-list">
    <view wx:if="{{empty}}" class="empty">
      <view>近期没有待提醒的事件</view>
      <view>点击右下角 + 计划下一件事</view>
    </view>
    <block wx:else>
      <view class="event {{multiOn && multiIds.indexOf(item.id) >= 0 ? 'multi-on' : ''}}" wx:for="{{list}}" wx:key="id" bindtap="onEventTap" bindlongpress="onEventLongPress" data-id="{{item.id}}">
        <view wx:if="{{multiOn}}" class="multi-check {{multiIds.indexOf(item.id) >= 0 ? 'on' : ''}}">✓</view>
        <view class="event-time">
          <text class="et-time">{{item.time}}</text>
          <text class="et-period">{{item.label}}</text>
        </view>
        <view class="event-body">
          <text class="eb-name">{{item.name}}</text>
          <text class="eb-note">{{item.note}}</text>
          <view class="tags">
            <view class="tag">
              <image wx:if="{{item.emojiImg}}" class="tag-img" src="{{item.emojiImg}}" mode="aspectFit" />
              <text wx:else>{{item.emojiText}}</text>
            </view>
            <view class="tag"><text>{{item.voiceTag}}</text></view>
            <view class="tag"><text>{{item.dateTag}}</text></view>
            <view class="tag" wx:if="{{item.repeatTag}}"><text>{{item.repeatTag}}</text></view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 多选删除操作条（对齐安卓 multiBar） -->
  <view class="multi-bar" wx:if="{{multiOn}}">
    <button class="secondary" bindtap="multiAll">全选</button>
    <button class="danger-btn" bindtap="multiDelete">删除({{multiIds.length}})</button>
    <button class="secondary" bindtap="multiExit">取消</button>
  </view>

  <button class="fab" bindtap="onAddTap">+</button>
  </view>
<genie id="geniecomp" showfab="{{false}}" />
