/* 预告页补充样式：全局 app.wxss 里部分排版依赖 HTML 标签选择器，这里以类名等价补充 */
.subhead-title{font-size:15px;font-weight:600}
.subhead-sub{color:var(--sub);font-size:12px}

.et-time{display:block;font-size:17px;line-height:1}
.et-period{display:block;font-size:10px;color:var(--sub);margin-top:4px;white-space:nowrap}
.eb-name{display:block;font-size:15px;line-height:1.3;margin:0 0 4px;font-weight:700}
.eb-note{display:block;font-size:12px;color:var(--sub);line-height:1.55;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag-img{width:20px;height:20px}

/* 日历入口 */
.up-head-row{display:flex;align-items:center;justify-content:space-between;margin-top:3px}
.cal-entry{font-size:24rpx;color:var(--accent);background:rgba(36,99,83,.1);border-radius:999rpx;padding:8rpx 20rpx;font-weight:600}
/* 自定义 tabBar 留白 */
.shell{padding-bottom:260rpx}