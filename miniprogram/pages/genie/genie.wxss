/* 精灵页 */
.shell{min-height:100vh;background:var(--bg);padding-bottom:130rpx}
.subhead{padding:14px 18px 4px}
.subhead-title{font-size:21px;font-weight:800;color:var(--text)}
.subhead-sub{display:block;font-size:12px;color:var(--sub);margin-top:3px}
.genie-hint{display:flex;align-items:flex-start;gap:16rpx;margin:12px 18px 0;padding:22rpx 24rpx}
.genie-hint-emoji{font-size:40rpx}
.genie-hint-text{flex:1;font-size:25rpx;color:var(--sub);line-height:1.6}
