/* 绸缪 · 小程序全局样式（移植自 Web 版 styles.css） */
page {
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  --bg:#eef4f1;
  --surface:#ffffff;
  --surface2:#f6faf8;
  --line:#d7e3dc;
  --main:#246353;
  --main2:#3b8d76;
  --text:#1c2a26;
  --sub:#6e7f79;
  --danger:#c65c52;
  --shadow:0 24px 70px rgba(18,48,39,.12);
  --radius-card:12px;
}
page{
      --bg:#eef4f1;
      --surface:#ffffff;
      --surface2:#f6faf8;
      --line:#d7e3dc;
      --main:#246353;
      --main2:#3b8d76;
      --text:#1c2a26;
      --sub:#6e7f79;
      --danger:#c65c52;
      --shadow:0 24px 70px rgba(18,48,39,.12);
      --radius-card:12px;
      --font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    }
    view, text, button, input, textarea, image, scroll-view, swiper, swiper-item, picker, form, label, navigator { box-sizing: border-box; }
    page{margin:0;padding:0;background:linear-gradient(180deg,#edf5f1 0%,#f7fbf8 100%);font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--text)}
    page{min-height:100vh}
    button,input,textarea,select{font:inherit}
    /* 注意：.shell 不能加 backdrop-filter/filter/transform，否则其内部的 position:fixed 底栏会相对它定位，随页面滚动沉底 */
    .shell{max-width:420px;margin:0 auto;min-height:100vh;background:rgba(255,255,255,.88);box-shadow:var(--shadow);position:relative;padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))}
    /* 吸顶头部：滚动时固定在顶部（含状态栏区域），内容从其下方滚过，解决与状态栏重叠 */
    .header{position:sticky;top:0;z-index:30;background:var(--page-bg);padding:calc(10px + var(--safe-top, env(safe-area-inset-top, 0px))) 18px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px;box-shadow:0 1px 0 rgba(17,45,36,.05)}
    .brand{display:flex;flex-direction:column;gap:4px}
    .brand strong{font-size:22px;line-height:1;letter-spacing:.02em}
    .brand span{font-size:12px;color:var(--sub)}
    .header-actions{display:flex;gap:8px}
    .icon-btn{width:38px !important;min-width:0 !important;height:38px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(17,45,36,.06);color:var(--text);cursor:pointer}
    .hero{margin:8px 18px 14px;padding:18px 16px;border-radius:24px;background:linear-gradient(135deg,var(--page-bg-color,#eef4f1) 0%,#fafbfc 100%);color:#fff;box-shadow:0 18px 34px rgba(36,99,83,.22);position:relative;overflow:hidden}
    .hero-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:16px}
    .hero-text{text-align:left;flex:1;min-width:0;padding-right:70px}
    .hero h4{font-size:12px;margin:0 0 6px;opacity:.75;letter-spacing:.05em;font-weight:600}
    .hero b{font-size:19px;display:block;line-height:1.35;margin-bottom:6px;word-wrap:break-word;color:#2c5f4d}
    .hero p{margin:0;font-size:13px;line-height:1.6;opacity:.95;color:#3a6b56}
    .hero-desc{margin-top:4px;font-size:13px;line-height:1.6;opacity:.9;color:#3a6b56}
    
    /* 装饰性小动物/二次元角色 */
    .hero-decoration{position:absolute;top:50%;right:-14px;width:130px;height:130px;transform:translateY(-50%);pointer-events:none;z-index:1;display:flex;align-items:center;justify-content:center}
    .decoration-item{font-size:68px;line-height:1;filter:drop-shadow(2px 4px 6px rgba(0,0,0,.16));transform:rotate(-15deg);animation:bounce 3s ease-in-out infinite;opacity:.9}
    
    @keyframes bounce {
      0%, 100% { transform: rotate(-15deg) translateY(0px); }
      50% { transform: rotate(-15deg) translateY(-10px); }
    }
    
    /* 幻灯片切换按钮：放到底部两侧，避开顶部计数框 */
    .slide-nav-btn{background:rgba(0,0,0,.14);border:none;width:30px;height:30px;border-radius:50%;color:#fff;cursor:pointer;font-size:15px;position:absolute;bottom:12px;margin:0;padding:0;z-index:3;transition:background .2s;line-height:1}
    .slide-nav-btn:hover{background:rgba(0,0,0,.26)}
    .slide-prev{left:10px}
    .slide-next{right:10px}
    .card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:14px;box-shadow:0 8px 22px rgba(17,45,36,.04)}
    .stat b{display:block;font-size:22px;line-height:1}
    .stat span{font-size:12px;color:var(--sub)}
    .subhead{display:flex;justify-content:space-between;align-items:center;padding:18px 18px 10px}
    .subhead h3{margin:0;font-size:15px;font-weight:600}
    .subhead small{color:var(--sub);font-size:12px;cursor:pointer}
    .pages{padding-bottom:88px}
    .page{display:none}
    .page.active{display:block}
    .today-list{padding:0 18px 12px}
    .empty{padding:24px 18px;text-align:center;color:var(--sub);font-size:13px;line-height:1.7}
    .event{display:flex;gap:12px;align-items:flex-start;padding:14px;border-radius:20px;background:var(--surface);border:1px solid var(--line);margin-bottom:10px;cursor:pointer}
    .event.done{opacity:.55}
    .event.done .event-body strong{text-decoration:line-through}
    .event-time{width:60px;text-align:center;padding-top:2px;font-weight:800;color:var(--main);flex-shrink:0}
    .event-time span{display:block;font-size:17px;line-height:1}
    .event-time small{display:block;font-size:10px;color:var(--sub);margin-top:4px;white-space:nowrap}
    .event-body{flex:1;min-width:0}
    .event-body strong{display:block;font-size:15px;line-height:1.3;margin-bottom:4px}
    .event-body p{margin:0;font-size:12px;color:var(--sub);line-height:1.55;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
    .tag{display:inline-flex;align-items:center;gap:4px;padding:5px 8px;border-radius:999px;background:var(--surface2);color:var(--main);font-size:11px;border:1px solid #e1ece5}
    .event-check{width:30px !important;min-width:0 !important;height:30px;border-radius:999px;border:1.5px solid var(--line);background:#fff;flex-shrink:0;cursor:pointer;font-size:14px;color:transparent;line-height:1}
    .event.done .event-check{background:var(--main);border-color:var(--main);color:#fff}
    .calendar-wrap{padding:0 18px 12px}
    .month-card{padding:16px;border-radius:24px;background:var(--surface);border:1px solid var(--line);box-shadow:0 8px 22px rgba(17,45,36,.04)}
    .month-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
    .month-top strong{font-size:16px}
    .month-nav{display:flex;gap:6px}
    .month-nav button{width:30px;height:30px;border-radius:10px;border:1px solid var(--line);background:#fff;cursor:pointer;color:var(--main);font-size:15px;line-height:1}
    .weekdays{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:10px}
    .weekdays div{font-size:11px;color:var(--sub);text-align:center}
    .days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
    .days .pad{visibility:hidden}
    .day{position:relative;min-width:0;height:50px;overflow:hidden;border-radius:14px;border:1px solid transparent;background:#fff;text-align:center;padding:4px;display:flex;flex-direction:column;justify-content:center;gap:2px;cursor:pointer}
    .day span{font-size:13px;font-weight:600;line-height:1}
    .day small{font-size:10px;color:var(--sub);line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
    /* 小屏手机：缩小格子内边距与字号，保持正方形格子不溢出 */
    @media (max-width:380px){
      .day{padding:3px 2px;gap:2px}
      .day span{font-size:12px}
      .day small{font-size:9px}
      .day-mark{top:2px;right:3px;font-size:7px;padding:1px 2px}
    }
    .day.today{border-color:var(--main);background:#f4fbf8}
    .day.has-event{background:#f8fbf9;border-color:#dfe9e3}
    .day.selected{background:var(--main);color:#fff;border-color:var(--main)}
    .day.selected small,.day.selected span{color:#fff}
    /* 节日：节日名红色显示 */
    .day.has-festival small{color:#d4574e;font-weight:600}
    .day.selected.has-festival small{color:#fff}
    /* 法定假日：放假日数字绿色 */
    .day.legal-rest span{color:#2c8a5f}
    .day.selected.legal-rest span{color:#fff}
    /* 角标：休/班/今/事件数 */
    .day-mark{position:absolute;top:3px;right:5px;font-size:8px;font-style:normal;font-weight:700;line-height:1;padding:2px 3px;border-radius:4px;color:#fff}
    .day.legal-rest .day-mark{background:#2c8a5f}
    .day.legal-work .day-mark{background:#8a95a1}
    .day.today .day-mark{background:var(--main)}
    .day.has-event .day-mark{background:#c9a54e}
    .day.selected .day-mark{background:rgba(255,255,255,.35);color:#fff}
    .agenda{margin-top:4px}
    /* 年月选择器 */
    .yp-year-row{display:flex;justify-content:center;align-items:center;gap:18px;margin-bottom:14px}
    .yp-btn{width:36px !important;min-width:0 !important;height:36px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--main);font-size:18px;cursor:pointer;line-height:1}
    .yp-months{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
    .yp-month{width:100% !important;min-width:0 !important;box-sizing:border-box;padding:10px 4px;border-radius:14px;border:1px solid var(--line);background:#fff;color:var(--text);font-size:16px;font-weight:600;cursor:pointer;line-height:1}
    .yp-month small{font-size:10px;font-weight:400;color:var(--sub);margin-left:1px}
    .yp-month.yp-current{border-color:var(--main);color:var(--main);background:#f4fbf8}
    .yp-month.yp-selected{background:var(--main);color:#fff;border-color:var(--main)}
    .yp-month.yp-selected small{color:#fff}
    .theme-dark .yp-btn,.theme-dark .yp-month{background:#1b2823;color:var(--text);border-color:var(--line)}
    .theme-dark .yp-month.yp-current{background:#22382f;border-color:var(--main);color:var(--main)}
    .theme-dark .yp-month.yp-selected{background:var(--main);color:#0c1512;border-color:var(--main)}
    .theme-dark .yp-month.yp-selected small{color:#0c1512}
    .agenda-item{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-radius:16px;background:var(--surface2);border:1px solid #e4ece8;margin-bottom:8px;cursor:pointer}
    .agenda-item strong{display:block;font-size:14px}
    .agenda-item span{font-size:12px;color:var(--sub)}
    .detail-wrap,.create-wrap{padding:0 18px 12px}
    .detail-card,.form-card{padding:16px;border-radius:24px;background:var(--surface);border:1px solid var(--line);box-shadow:0 8px 22px rgba(17,45,36,.04)}
    .detail-title{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}
    .detail-title strong{font-size:18px;line-height:1.2}
    .status-pill{padding:6px 10px;border-radius:999px;background:var(--surface2);color:var(--main);font-size:11px;border:1px solid #e1ece5;white-space:nowrap}
    .meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
    .meta{padding:12px;border-radius:16px;background:var(--surface2);border:1px solid #e1ece5}
    .meta small{display:block;color:var(--sub);font-size:12px;margin-bottom:4px}
    .meta b{font-size:14px;line-height:1.4}
    .detail-note{padding:14px;border-radius:16px;background:#fff;border:1px solid var(--line);font-size:14px;line-height:1.7;color:var(--text)}
    .field{margin-top:12px}
    .field:first-child{margin-top:0}
    .field label{display:block;font-size:12px;color:var(--sub);margin-bottom:6px}
    .field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:16px;padding:12px 14px;background:#fff;outline:none;color:var(--text)}
    /* 原生 input 高度固定且不随 padding 撑开：border-box 下必须显式高度，否则内容区被挤没（iOS 上文字不可见） */
    .field input{height:48px}
    .field input:focus,.field textarea:focus{border-color:var(--main)}
    .field textarea{min-height:88px;resize:none}
    .field .err{color:var(--danger);font-size:11px;margin-top:4px;display:none}
    .chips{display:flex;flex-wrap:wrap;gap:8px}
    .chip{padding:9px 12px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:12px;cursor:pointer;color:var(--text)}
    .chip.selected{background:var(--main);color:#fff;border-color:var(--main)}
    .recorder{margin-top:10px;padding:14px;border-radius:16px;background:var(--surface2);border:1px solid #e1ece5;display:none}
    .recorder.show{display:block}
    .rec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
    .rec-head small{color:var(--sub);font-size:12px}
    .rec-time{font-weight:800;color:var(--main);font-size:15px;font-variant-numeric:tabular-nums}
    .rec-time.recording{color:var(--danger);animation:pulse 1s infinite}
    @keyframes pulse{50%{opacity:.4}}
    .rec-actions{display:flex;gap:8px;margin-top:10px}
    .rec-actions button{flex:1;border-radius:14px;border:1px solid var(--line);background:#fff;padding:10px;font-weight:700;cursor:pointer;font-size:13px}
    .rec-actions .rec-main{background:linear-gradient(135deg,var(--main) 0%,var(--main2) 100%);color:#fff;border:0}
    .action-row{display:flex;gap:10px;margin-top:14px}
    .primary,.secondary,.danger-btn{flex:1;border:0;border-radius:16px;padding:13px 14px;font-weight:700;cursor:pointer}
    .primary{background:linear-gradient(135deg,var(--main) 0%,var(--main2) 100%);color:#fff;box-shadow:0 14px 24px rgba(36,99,83,.18)}
    .secondary{background:#fff;color:var(--main);border:1px solid var(--line)}
    .danger-btn{background:#fff;color:var(--danger);border:1px solid #e8d5d2}
    .mini{font-size:12px;color:var(--sub);line-height:1.6}
    .toast{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(18px);padding:12px 16px;border-radius:14px;background:#1c2a26;color:#fff;font-size:12px;opacity:0;transition:.25s;pointer-events:none;max-width:88vw;text-align:center;box-shadow:0 14px 24px rgba(0,0,0,.18);z-index:50}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
    .tabs{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:420px;background:rgba(255,255,255,.94);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding:8px 0 calc(10px + env(safe-area-inset-bottom,0px));z-index:10}
    .tab{border:0;background:none;color:var(--sub);display:flex;flex-direction:column;gap:4px;align-items:center;font-size:11px;cursor:pointer}
    .tab.active{color:var(--main);font-weight:700}
    .tab i{font-style:normal;font-size:18px;line-height:1}
    .fab{position:fixed;right:50%;transform:translateX(175px);bottom:calc(82px + env(safe-area-inset-bottom,0px));width:58px !important;min-width:0 !important;height:58px;border-radius:20px;border:0;background:linear-gradient(135deg,var(--main) 0%,var(--main2) 100%);color:#fff;font-size:30px;box-shadow:0 16px 30px rgba(36,99,83,.28);cursor:pointer;z-index:11}
    /* inset 简写属性在 WXSS/旧 iOS WebView 不支持，必须拆成四个方向，否则遮罩失去定位导致弹层超出布局 */
    .remind-fullscreen{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(238,244,241,.97);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;z-index:100;padding:24px}
    .remind-fullscreen.show{display:flex}
    .remind-card{text-align:center;max-width:340px;width:100%}
    .remind-card .emoji{font-size:64px;line-height:1;margin-bottom:14px}
    .remind-card h2{margin:0 0 6px;font-size:22px}
    .remind-card p{margin:0 0 6px;color:var(--sub);font-size:13px;line-height:1.6}
    .remind-card time{display:block;font-size:40px;font-weight:800;color:var(--main);margin:10px 0 20px;letter-spacing:.02em}
    @media (max-width:420px){.fab{right:18px;transform:none}}

    /* ============ 错过提醒横幅 ============ */
    .missed-wrap{padding:0 18px 6px}
    .missed-banner{background:linear-gradient(135deg,#fff7e8 0%,#fffdf5 100%);border:1px solid #f0dfbb;border-radius:18px;padding:12px 14px;margin-bottom:10px;box-shadow:0 8px 22px rgba(17,45,36,.05)}
    .missed-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
    .missed-head strong{font-size:13px;color:#9a6a00}
    .missed-close{border:0;background:none;color:var(--sub);cursor:pointer;font-size:13px;padding:4px;line-height:1}
    .missed-item{display:flex;gap:8px;align-items:center;padding:7px 4px;border-top:1px dashed #efe2c2;font-size:13px;cursor:pointer}
    .missed-item span{color:var(--main);font-weight:700;font-variant-numeric:tabular-nums}
    .missed-item b{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .missed-more{font-size:11px;color:var(--sub);padding:6px 4px 0}

    /* ============ 提醒弹层多档贪睡 ============ */
    .snooze-row{display:flex;gap:8px;margin-bottom:12px}
    .snooze-row button{flex:1;padding:10px 8px;font-size:12px}

    /* ============ 自动备份列表 ============ */
    .backup-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:14px;margin-top:8px;background:var(--surface2);overflow:hidden}
    .backup-info{flex:1;min-width:0}
    .backup-info b{display:block;font-size:13px}
    .backup-info small{font-size:11px;color:var(--sub)}
    .backup-actions{display:flex;gap:6px;flex-shrink:0}
    .backup-actions button{flex:none;padding:8px 12px;font-size:12px;border-radius:12px}

    /* ============ 动效（尊重减少动效偏好） ============ */
    .page.active{animation:pageIn .28s ease both}
    @keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    .event{transition:transform .12s ease}
    .event:active{transform:scale(.985)}
    .primary:active,.secondary:active,.danger-btn:active,.chip:active,.month-nav button:active{transform:scale(.96)}
    .fab{transition:filter .12s ease}
    .fab:active{filter:brightness(.85)}
    .fab.hidden{display:none}
    /* 原生 App 中隐藏仅网页开放的功能 */
    .remind-card{animation:popIn .3s cubic-bezier(.2,.9,.3,1.15) both}
    @keyframes popIn{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion:reduce){.page.active,.remind-card{animation:none}}

    /* ============ 深色模式 ============ */
    page{--page-bg:linear-gradient(180deg,#edf5f1 0%,#f7fbf8 100%)}
    page{background:var(--page-bg)}
    .theme-dark{
      --page-bg:linear-gradient(180deg,#0e1613 0%,#131d19 100%);
      --surface:#18241f;
      --surface2:#1d2c26;
      --line:#2c4038;
      --main:#4fae92;
      --main2:#6cc2a8;
      --text:#e7f0ec;
      --sub:#9db0a8;
      --danger:#e07a6f;
      --shadow:0 24px 70px rgba(0,0,0,.45);
    }
    .theme-dark .shell{background:rgba(20,30,26,.92)}
    .theme-dark .icon-btn{background:rgba(26,39,34,.92);border-color:var(--line)}
    .theme-dark .tag,.theme-dark .status-pill,.theme-dark .meta,.theme-dark .agenda-item,.theme-dark .recorder{border-color:var(--line)}
    .theme-dark .event-check,.theme-dark .chip,.theme-dark .day,.theme-dark .month-nav button,.theme-dark .secondary,.theme-dark .danger-btn,.theme-dark .rec-actions button,.theme-dark .field input,.theme-dark .field textarea,.theme-dark .detail-note{background:#1b2823;color:var(--text);border-color:var(--line)}
    .theme-dark .day.today{background:#22382f;border-color:var(--main)}
    .theme-dark .day.has-event{background:#1e2d27}
    .theme-dark .day.selected{background:var(--main);color:#0c1512;border-color:var(--main)}
    .theme-dark .day.selected small,.theme-dark .day.selected span{color:#0c1512}
    .theme-dark .chip.selected{background:var(--main);color:#0c1512;border-color:var(--main)}
    .theme-dark .tabs{background:rgba(20,30,26,.94)}
    .theme-dark .remind-fullscreen{background:rgba(15,23,20,.97)}
    .theme-dark .toast{background:#e7f0ec;color:#12201b}
    .theme-dark .missed-banner{background:linear-gradient(135deg,#2b2414 0%,#241f12 100%);border-color:#4a3f22}
    .theme-dark .missed-head strong{color:#e3b95c}
    .theme-dark .missed-item{border-top-color:#3d341f}
    /* ---------------- 拾光精灵 ---------------- */
    .genie-fab{position:fixed;right:18px;bottom:calc(150px + env(safe-area-inset-bottom,0px));width:54px;height:54px;border-radius:50%;border:none;background:linear-gradient(135deg,#7c5cff 0%,#5b8cff 100%);cursor:pointer;box-shadow:0 8px 22px rgba(94,99,255,.42);z-index:40;display:grid;place-items:center;transition:transform .2s;padding:0;overflow:hidden}
    .genie-fab img{width:100%;height:100%;object-fit:cover;display:block}
    .genie-fab:hover{transform:scale(1.08)}
    .genie-panel{position:fixed;left:50%;bottom:calc(80px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);width:min(390px,calc(100vw - 28px));max-height:min(560px,calc(100vh - 120px));background:var(--surface,#fff);border-radius:22px;box-shadow:0 24px 60px rgba(18,48,39,.28);display:flex;flex-direction:column;z-index:45;opacity:0;pointer-events:none;transition:opacity .22s,transform .22s}
    .genie-panel.show{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
    .genie-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line,#d7e3dc)}
    .genie-head .genie-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#7c5cff,#5b8cff);display:grid;place-items:center;overflow:hidden;flex-shrink:0}
    .genie-head .genie-avatar img{width:100%;height:100%;object-fit:cover;display:block}
    .genie-head b{font-size:16px}
    .genie-head small{display:block;color:var(--sub,#6e7f79);font-size:11px}
    .genie-close{margin-left:auto;border:none;background:transparent;font-size:20px;color:var(--sub,#6e7f79);cursor:pointer;padding:4px}
    .genie-bubbles{flex:1;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
    .genie-bubble{max-width:82%;padding:10px 13px;border-radius:16px;font-size:14px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
    .genie-assistant{align-self:flex-start;background:var(--surface2,#f6faf8);border-bottom-left-radius:4px;color:var(--text,#1c2a26)}
    .genie-user{align-self:flex-end;background:linear-gradient(135deg,#7c5cff,#5b8cff);color:#fff;border-bottom-right-radius:4px}
    .genie-inputbar{display:flex;align-items:center;gap:8px;padding:10px 12px;border-top:1px solid var(--line,#d7e3dc)}
    .genie-inputbar input{flex:1;height:40px;border:1px solid var(--line,#d7e3dc);border-radius:20px;padding:10px 14px;font-size:14px;background:var(--surface,#fff);color:var(--text,#1c2a26);outline:none}
    .genie-inputbar input:focus{border-color:var(--main2,#3b8d76)}
    .genie-inputbar button{border:none;background:transparent;cursor:pointer;font-size:22px;padding:6px}
    #genieVoiceBtn.recording{color:#c65c52;animation:geniePulse 1s infinite}
    @keyframes geniePulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ---------------- 小程序原生组件重置 ---------------- */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  box-sizing: border-box;
  overflow: visible;
  /* 微信框架给原生 button 注入约 184px 默认宽度且带更高优先级，压过一切 class 非重要宽度
     （实测 fab 58px/月格子/备份按钮全被撑到 184 导致行溢出）——必须用 !important 压回，
     需要固定/满宽的按钮在各自类里再以 !important 覆盖（类 !important 优先级更高） */
  width: auto !important;
  min-width: 0 !important;
}
button::after { border: none; }
input, textarea { font-family: inherit; }
.shell { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px)) !important; }