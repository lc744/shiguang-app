<view class="tabs {{dark ? 'dark' : ''}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab-active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image wx:if="{{index === 2}}" class="tab-genie-img" src="/images/genie.jpg" mode="aspectFill" />
    <text wx:else class="tab-icon">{{item.icon}}</text>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
